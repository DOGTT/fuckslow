    pressure_label = tr("压力", "pressure") if sys.platform == "darwin" else tr("压力估算", "estimated pressure")
    type_line(tr(f"内存｜{pressure_label} {level} · RAM {amount(sample.ram)} · 已用交换 {used_swap}",
                 f"Memory | {pressure_label} {level} · RAM {amount(sample.ram)} · swap used {used_swap}"), animate)
    system_memory = [
        f"{label} {amount(value)}" for label, value in (
            (tr("可用", "available"), sample.available),
            (tr("联动内存", "wired"), sample.wired),
            (tr("压缩", "compressed"), sample.compressed),
            (tr("文件页", "file-backed pages") if sys.platform == "darwin" else tr("缓存", "cache"), sample.cache),
        ) if value is not None
    ]
    if system_memory:
        type_line(tr("系统内存｜", "System memory | ") + " · ".join(system_memory), animate)
    if rates:
        type_line(tr(f"交换｜最近 {sample.elapsed:.1f} 秒平均，每秒读入 {swap_in} · 写出 {swap_out}",
                     f"Swap | {sample.elapsed:.1f}s average · in {swap_in}/s · out {swap_out}/s"), animate)
    cpu_idle = (tr(f"整机空闲 {idle:.1f}%", f"{idle:.1f}% system idle") if idle is not None
                else tr("整机空闲率不可用", "system idle unavailable"))
    type_line(tr("CPU｜", "CPU | ") + cpu_idle, animate)
    type_line(tr(f"磁盘｜系统盘可用 {amount(sample.disk_free)}",
                 f"Disk | system volume free {amount(sample.disk_free)}"), animate)

    explained = set()
    for title, names, field, entries in (
        (sample.metric, by_memory, "memory", groups),
        (sample.cpu_title, by_cpu, "cpu", cpu_groups),
    ):
        if not names:
            continue
        print(tr(f"\n{title}排行（按应用或进程归并）", f"\nTop by {title} (grouped by app or process)"))
        for name in names[:args.limit]:
            members = entries[name]
            value = sum(getattr(p, field) for p in members)
            highest = max(members, key=lambda p: getattr(p, field))
            label = amount(value) if field == "memory" else f"{value:.1f}%"
            group = terminal_text(name)
            peak = f"{terminal_text(highest.name)} (PID {highest.pid})"
            type_line(tr(f"  {label}  {group} · {len(members)} 个进程 · 最高 {peak}",
                         f"  {label}  {group} · {len(members)} process(es) · top: {peak}"), animate)
            note = system_note(name) or system_note(highest.name)
            if note and note not in explained:
                type_line(tr("    ↳ 系统进程｜", "    ↳ System process | ") + note, animate)
                explained.add(note)
        if field == "memory":
            show_memory_tail(names, entries, args.limit, animate)

    if not groups:
        print(tr("\n没有可用的进程内存样本。", "\nNo process memory samples available."))
    heading(tr("02  现场结论", "02  Findings"))
    type_line(tr("，", " ").join(findings) if findings else
              tr("短采样未发现明确瓶颈", "No clear bottleneck during this sample.") if measured
              else tr("部分采样不可用，暂时无法确定瓶颈", "Some samples are missing. No reliable diagnosis yet."), animate)
    if low_disk:
        print(tr("  • 先把系统盘上能归档的大文件移走。", "  • Move large files you can archive off the system drive."))
    cpu_first = busy_cpu and not (pressure in {"2", "4"} or active_swap)
    candidates, entries = (by_cpu, cpu_groups) if cpu_first else (by_memory, groups)
    if findings or pressure not in PRESSURE or idle is None:
        suggested = [name for name in candidates if not system_note(name)]
        for name in suggested[:3]:
            type_line(f"  • {terminal_text(name)}{tr('。', ': ')}{action(name, entries[name])}", animate)
    if findings:
        print(tr("  • 先处理一个确认闲置的高占用项，等约 30 秒再跑一次。", "  • Quit one heavy app you know is idle. Wait about 30 seconds, then rerun."))
    else:
        print(tr("  • 如果卡顿重现，在卡顿时用 --seconds 5 再测。", "  • If it bogs down again, rerun with --seconds 5 while it's happening."))
    if findings:
        print(tr("  • 卡到界面都动不了，或关掉大户后还持续卡，先保存再重启。",
                 "  • If the UI is nearly unusable or quitting heavy apps doesn't help, save and reboot."))
    print()
    type_line(roast(pressure, swap_rate, busy_cpu, low_disk, measured), animate,
              "1;31" if findings else "1;32")
    can_quit = sys.platform == "win32" or os.getuid() != 0
    if interactive and (busy_cpu or active_swap or pressure in {"2", "4"}) and can_quit:
        targets = quit_targets(candidates, entries, tree, cpu_first, min(args.limit, 5))
        quit_menu(targets, animate)
    return 0 if groups else 1


if __name__ == "__main__":
    sys.exit(main())
