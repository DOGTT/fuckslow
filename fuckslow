def system_note(name):
    key = name.casefold().removesuffix(".exe").strip("[]")
    if sys.platform == "darwin":
        if key.startswith("mdworker_"):
            key = "mdworker"
    elif sys.platform == "win32":
        key = {"vmmem": "wsl / hyper-v", "vmmemwsl": "wsl"}.get(key, key)
    elif sys.platform == "linux":
        if re.match(r"^kswapd\d+$", key):
            key = "kswapd"
        elif key.startswith("kworker/"):
            key = "kworker"
        elif key == "systemd-journal":
            key = "systemd-journald"
    note = SYSTEM_PROCESSES.get(sys.platform, {}).get(key)
    return tr(*note) if note else ""


