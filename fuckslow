def ansi_terminal():
    if sys.platform == "win32":
        return sys.stdout.isatty() and WINDOWS_VT
    return sys.stdout.isatty() and os.environ.get("TERM") not in {None, "dumb"}


def enable_windows_vt():
    from ctypes import wintypes

    kernel = ctypes.windll.kernel32
    kernel.GetStdHandle.restype = wintypes.HANDLE
    handle = kernel.GetStdHandle(-11)
    mode = wintypes.DWORD()
    return bool(kernel.GetConsoleMode(wintypes.HANDLE(handle), ctypes.byref(mode))
                and kernel.SetConsoleMode(wintypes.HANDLE(handle), mode.value | 4))


def color_enabled():
    return ansi_terminal() and "NO_COLOR" not in os.environ


def style(message, code):
    if color_enabled():
        return f"\033[{code}m{message}\033[0m"
    return message


def type_line(message, animate, code="0"):
    if not animate:
        print(style(message, code), flush=True)
        return
    colored = color_enabled()
    if colored:
        sys.stdout.write(f"\033[{code}m")
    try:
        for offset in range(0, len(message), 3):
            print(message[offset:offset + 3], end="", flush=True)
            time.sleep(0.009)
    finally:
        print("\033[0m" if colored else "", flush=True)


def heading(label):
    print("\n" + style(f"━━ {label} ━━", "1;36"))


