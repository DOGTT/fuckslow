def terminal_text(value):
    return "".join(char for char in value if char.isprintable())


def is_main_app(path):
    bundle, separator, remainder = path.partition(".app/")
    prefix = "Contents/MacOS/"
    if not separator or not bundle.startswith("/") or not remainder.startswith(prefix):
        return False
    executable = remainder[len(prefix):]
    if not executable or "/" in executable:
        return False
    try:
        with open(bundle + ".app/Contents/Info.plist", "rb") as file:
            return plistlib.load(file).get("CFBundleExecutable") == executable
    except (OSError, ValueError, plistlib.InvalidFileException):
        return False


def quit_targets(names, groups, tree, cpu_first, limit):
    ancestors = set()
    pid = os.getpid()
    while pid in tree and pid not in ancestors:
        ancestors.add(pid)
        pid = tree[pid].parent
    ancestors.add(os.getppid())
    mac = sys.platform == "darwin"
    usage = rusage_reader() if mac else None
    owner = os.getuid() if sys.platform != "win32" else PSUTIL.Process().username()
    targets = []
    for name in names:
        members = groups[name]
        field = "cpu" if cpu_first else "memory"
        for process in sorted(members, key=lambda p: getattr(p, field), reverse=True):
            pid = process.pid
            info = tree.get(pid)
            if info is None or info.uid != owner or pid <= 1 or pid in ancestors or system_note(process.name):
                continue
            path = info.path
            if path.startswith(("/System/", "/usr/libexec/")):
                continue
            emulator = name == "Android Emulator" and process.name.startswith("qemu-system")
            parent = tree.get(info.parent)
            agent = bool(info.agent and (parent is None or parent.agent != info.agent))
            portable_app = (not mac and info.app and os.path.isabs(path)
                            and (parent is None or parent.app != info.app))
            signal_quit = emulator or agent or bool(portable_app)
            if not signal_quit and not is_main_app(path):
                continue
            identity = usage(pid) if mac else None
            started = identity.start_abstime if identity else info.started
            if not started:
                continue
            if signal_quit:
                load = f"{process.cpu:.1f}%" if cpu_first else amount(process.memory)
            else:
                load = (f"{sum(p.cpu for p in members):.1f}%" if cpu_first
                        else amount(sum(p.memory for p in members))) + tr("（应用组）", " (app group)")
            targets.append(QuitTarget(pid, name, path, started, signal_quit, load))
        if len(targets) >= limit:
            break
    return targets[:limit]


