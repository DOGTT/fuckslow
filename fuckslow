class RUsageV0(ctypes.Structure):
    _fields_ = [("uuid", ctypes.c_uint8 * 16)] + [
        (field, ctypes.c_uint64) for field in (
            "user_time", "system_time", "pkg_idle_wakeups", "interrupt_wakeups",
            "pageins", "wired_size", "resident_size", "phys_footprint",
            "start_abstime", "exit_abstime",
        )
    ]


def rusage_reader():
    try:
        query = ctypes.CDLL("/usr/lib/libproc.dylib").proc_pid_rusage
    except (OSError, AttributeError):
        return lambda pid: None
    query.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_void_p]
    query.restype = ctypes.c_int

    def read_usage(pid):
        usage = RUsageV0()
        if query(pid, 0, ctypes.byref(usage)) == 0:
            return usage
        return None

    return read_usage


def footprints(tree):
    usage = rusage_reader()
    return {pid: info.phys_footprint for pid in tree if (info := usage(pid)) is not None}


def read(*command, timeout=5):
    try:
        result = subprocess.run(
            command, capture_output=True, text=True, errors="replace",
            env={**os.environ, "LC_ALL": "C"}, timeout=timeout, check=True,
        )
        return result.stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def detect_language():
    for key in ("LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(key, "").strip()
        if value:
            language = re.split(r"[-_.@]", value.lower(), maxsplit=1)[0]
            return "zh" if language == "zh" else "en"
    if sys.platform == "darwin":
        languages = read("/usr/bin/defaults", "read", "-g", "AppleLanguages", timeout=1)
        first = re.search(r'\(\s*"?([a-zA-Z]+)', languages)
        if first and first[1].lower() == "zh":
            return "zh"
    if sys.platform == "win32":
        locale_name = ctypes.create_unicode_buffer(85)
        if ctypes.windll.kernel32.GetUserDefaultLocaleName(locale_name, len(locale_name)):
            return "zh" if locale_name.value.lower().startswith("zh-") else "en"
    return "en"


def tr(chinese, english):
    return chinese if LANGUAGE == "zh" else english


def size(value):
    match = re.fullmatch(r"(\d+(?:\.\d+)?)\s*([BKMGT]?)[*+-]*", value)
    if match is None:
        return None
    number, unit = match.groups()
    return int(float(number) * 1024 ** "BKMGT".index(unit or "B"))


def amount(value):
    if value is None:
        return tr("未知", "unknown")
    if value >= GIB:
        return f"{value / GIB:.2f} GiB"
    return f"{value / MIB:.1f} MiB"


def vm_snapshot():
    output = read("/usr/bin/vm_stat")
    page = re.search(r"page size of (\d+) bytes", output)
    if not page:
        return {}
    return {
        "Page size": int(page[1]),
        **{
            key: int(value) * int(page[1])
            for key, value in re.findall(r"^([^:\n]+):\s+(\d+)\.", output, re.M)
        },
    }


def parse_top(output):
    samples = re.split(r"^Processes:", output, flags=re.M)
    if len(samples) < 3:
        return None, []
    sample = samples[-1]
    idle = re.search(r"CPU usage:.*?([\d.]+)% idle", sample)
    processes = []
    for line in sample.splitlines():
        fields = line.split(maxsplit=3)
        if len(fields) != 4 or not fields[0].isdigit():
            continue
        pid, cpu, memory, name = fields
        memory = size(memory)
        if memory is not None and re.fullmatch(r"\d+(?:\.\d+)?", cpu):
            processes.append(Process(int(pid), float(cpu), memory, name))
    return float(idle[1]) if idle else None, processes


def process_tree(output):
    tree = {}
    for line in output.splitlines():
        fields = line.split(maxsplit=5)
        if len(fields) == 6 and all(field.isdigit() for field in fields[:4]):
            pid, parent, rss, uid, cpu, path = fields
            if re.fullmatch(r"\d+(?:\.\d+)?", cpu):
                tree[int(pid)] = ProcessInfo(int(parent), int(rss) * 1024, float(cpu), path, int(uid))
    return tree


def identify_agent(path, command="", entry_script=None):
    executable = os.path.basename(path)
    if sys.platform == "win32":
        path = path.replace("\\", "/")
        executable = os.path.basename(path).lower().removesuffix(".exe")
    if executable == "dsh":
        resolved = os.path.realpath(path).replace("\\", "/")
        return AGENT_EXECUTABLES[executable] if any(
            marker in resolved for marker in ("/@deepseek-ai/dsh/", "/DeepSeek Harness.app/")
        ) else ""
    if ".app/" in path:
        if "/DeepSeek Harness.app/" in path and command.startswith(path + " "):
            entry = command[len(path) + 1:].removeprefix("--expose-internals ")
            if re.match(r".*?/DeepSeek Harness\.app/Contents/Resources/runtime/cli/", entry):
                return "DeepSeek Harness CLI"
        return ""
    if executable in AGENT_EXECUTABLES:
        return AGENT_EXECUTABLES[executable]
    if re.search(r"/\.local/share/claude/versions/[\d.]+$", path):
        return "Claude Code"
    if not re.fullmatch(r"node(?:js)?|bun|electron", executable, re.I):
        return ""
    # Only inspect the entry script, never provider names or script arguments.
    if entry_script is None:
        _, _, script = command.partition(" ")
        script = script.removeprefix("--expose-internals ")
        script = script.lstrip().split(maxsplit=1)[0] if script.strip() else ""
    else:
        script = entry_script.replace("\\", "/")
    if not script or script.startswith("-"):
        return ""
    for package, name in AGENT_PACKAGES.items():
        if f"/node_modules/{package}/" in script:
            return name
    if "/node_modules/.bin/" in script:
        return AGENT_EXECUTABLES.get(os.path.basename(script), "")
    return ""


def tag_agents(tree, output):
    commands = {}
    for line in output.splitlines():
        fields = line.split(maxsplit=1)
        if len(fields) == 2 and fields[0].isdigit():
            commands[int(fields[0])] = fields[1]
    for pid, info in tree.items():
        info.agent = identify_agent(info.path, commands.get(pid, ""))


def app_group(process, tree):
    if system_note(process.name):
        return process.name
    pid = process.pid
    visited = set()
    while pid in tree and pid not in visited:
        visited.add(pid)
        info = tree[pid]
        path = info.path
        executable = os.path.basename(path)
        if executable.startswith("qemu-system") and "/emulator/qemu/" in path.replace("\\", "/"):
            return "Android Emulator"
        if executable.startswith(("Codex (", "Codex Helper")):
            return "Codex"
        if info.agent:
            return info.agent
        if info.app:
            return info.app
        app = re.search(r"(?:^|/)([^/]+)\.app/", path)
        if app:
            return APP_NAMES.get(app[1], app[1])
        if executable in HELPER_NAMES:
            return HELPER_NAMES[executable]
        if executable.startswith("com.docker."):
            return "Docker"
        if executable.startswith("qemu-system-"):
            return "QEMU"
        pid = info.parent
    name = process.name
    if name.startswith(("Codex (", "Codex Helper")):
        return "Codex"
    for prefix, app in HELPER_NAMES.items():
        if name == prefix or name.startswith(prefix + " (") or (
            prefix.endswith((".", "-")) and name.startswith(prefix)
        ):
            return app
    return name


