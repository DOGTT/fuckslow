def request_quit(target):
    if sys.platform != "darwin":
        return request_portable_quit(target)
    usage = rusage_reader()
    current = usage(target.pid)
    if current is None or current.start_abstime != target.started:
        return tr("进程已退出或身份变了。重新扫描再选。", "Process exited or its identity changed. Rerun before selecting it again."), False
    try:
        if target.signal_quit:
            os.kill(target.pid, signal.SIGTERM)
        elif read("/usr/bin/osascript", "-l", "JavaScript", "-e", QUIT_APP_SCRIPT,
                  str(target.pid), target.path).strip() != "sent":
            return tr("macOS 没有确认退出请求。请检查应用窗口或手动退出。", "macOS didn't acknowledge the quit request. Check the app or quit it manually."), False
    except OSError:
        return tr("退出请求没发出去。进程可能已退出，或系统拒绝了操作。", "Couldn't send the quit request. The process may have exited, or macOS denied it."), False
    for attempt in range(50):
        current = usage(target.pid)
        if current is not None and current.start_abstime != target.started:
            return tr("💥 FUCK IT. 目标已退出。", "💥 FUCK IT. Target exited."), True
        if current is None:
            try:
                os.kill(target.pid, 0)
            except ProcessLookupError:
                return tr("💥 FUCK IT. 目标已退出。", "💥 FUCK IT. Target exited."), True
            except PermissionError:
                pass
        if attempt % 10 == 0:
            state = read("/bin/ps", "-p", str(target.pid), "-o", "state=", timeout=1).strip()
            if state.startswith("Z"):
                return tr("💥 FUCK IT. 目标已退出。", "💥 FUCK IT. Target exited."), True
        time.sleep(0.1)
    return tr("已发出退出请求，进程仍在运行。去应用里看看有没有保存提示。", "Quit requested. Still running. Check the app for a save prompt."), False


def request_portable_quit(target):
    try:
        process = PSUTIL.Process(target.pid)
        if process.create_time() != target.started:
            return tr("PID 换人了，重新扫描再选。", "PID was reused. Rerun before selecting it again."), False
        process.terminate()
        process.wait(timeout=5)
    except PSUTIL.NoSuchProcess:
        pass
    except PSUTIL.TimeoutExpired:
        return tr("发了退出请求，还在跑。", "Termination requested. Still running."), False
    except (PSUTIL.AccessDenied, OSError):
        return tr("系统拒绝了关闭操作。", "The system denied termination."), False
    return tr("💥 FUCK IT. 目标已退出。", "💥 FUCK IT. Target exited."), True


def fit_line(message, columns):
    end = 0
    for char in message:
        columns -= 2 if unicodedata.east_asian_width(char) in {"W", "F", "A"} else 1
        if columns < 0:
            break
        end += 1
    return message[:end]


def choose_targets(rows, animate):
    prompt = tr("多选（如 123 或 32，回车锁定）› ", "Pick numbers (e.g. 123 or 32), then Enter › ")
    valid = {str(index) for index in range(1, len(rows) + 1)}
    if not animate or shutil.get_terminal_size().lines <= len(rows) + 2:
        for row in rows:
            print(row)
        while True:
            digits = input(prompt).strip()
            if all(digit in valid for digit in digits):
                return list(dict.fromkeys(digits))
            print(tr("请输入榜上的编号，或者回车跳过。", "Use a number from the list, or press Enter to skip."))

    selected = []
    columns = shutil.get_terminal_size().columns

    def draw(offset=0, active="", redraw=False):
        if redraw:
            sys.stdout.write(f"\r\033[{len(rows)}A")
        for index, row in enumerate(rows, 1):
            digit = str(index)
            line = fit_line((" " * offset if active == digit else "") + row, columns - 1)
            if redraw:
                sys.stdout.write("\r\033[2K")
            sys.stdout.write(style(line, "1;31") if digit in selected else line)
            sys.stdout.write("\n")
        if redraw:
            sys.stdout.write("\r\033[2K")
        sys.stdout.write(fit_line(prompt + "".join(selected), columns - 1))
        sys.stdout.flush()

    if sys.platform == "win32":
        import msvcrt

        def read_key():
            key = msvcrt.getwch()
            if key in {"\x00", "\xe0"}:
                msvcrt.getwch()
                return " "
            if key == "\x03":
                raise KeyboardInterrupt
            return key
    else:
        fd = sys.stdin.fileno()
        settings = termios.tcgetattr(fd)

        def read_key():
            raw = os.read(fd, 1)
            return raw.decode("ascii", errors="replace")
    draw()
    try:
        if sys.platform != "win32":
            tty.setcbreak(fd)
        while True:
            key = read_key()
            if key in {"", "\x04", "\r", "\n"}:
                return selected if key in {"\r", "\n"} else []
            if key in {"\x7f", "\b"} and selected:
                selected.pop()
                draw(redraw=True)
            elif key in valid and key not in selected:
                selected.append(key)
                for offset in (3, 0, 2, 0):
                    draw(offset, key, redraw=True)
                    time.sleep(0.035)
    finally:
        if sys.platform != "win32":
            termios.tcsetattr(fd, termios.TCSADRAIN, settings)
        print()


def attack(target, animate):
    name = terminal_text(target.name)
    label = f"{name} · PID {target.pid}"
    if not animate:
        type_line(tr(f"正在关闭 {label}…", f"Quitting {label}…"), False)
        return request_quit(target)

    columns = shutil.get_terminal_size().columns
    frames = ("✦", "⚡", "✷", "💥")
    with ThreadPoolExecutor(max_workers=1) as executor:
        pending = executor.submit(request_quit, target)
        frame = 0
        try:
            while True:
                effect = frames[frame % len(frames)]
                line = f"{' ' * (frame % 3)}{effect} FUCK IT  ›  {label}"
                print("\r\033[2K" + style(fit_line(line, columns - 1), "1;31"), end="", flush=True)
                try:
                    return pending.result(timeout=0.10)
                except FutureTimeout:
                    frame += 1
        finally:
            print("\r\033[2K", end="", flush=True)


