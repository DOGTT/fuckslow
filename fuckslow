def sample_mac(seconds):
    start = time.monotonic()
    before = vm_snapshot()
    idle, processes = parse_top(read(
        "/usr/bin/top", "-l", "2", "-s", str(seconds),
        "-stats", "pid,cpu,mem,command", timeout=seconds + 4,
    ))
    remaining = seconds - (time.monotonic() - start)
    if remaining > 0:
        time.sleep(remaining)
    after = vm_snapshot()
    elapsed = time.monotonic() - start
    tree = process_tree(read("/bin/ps", "-ww", "-axo", "pid=,ppid=,rss=,uid=,%cpu=,comm="))
    interpreters = [
        str(pid) for pid, info in tree.items()
        if os.path.basename(info.path).lower() in {"node", "nodejs", "bun", "electron"}
        or "/DeepSeek Harness.app/Contents/MacOS/" in info.path
    ]
    agent_args = read("/bin/ps", "-ww", "-p", ",".join(interpreters), "-o", "pid=,args=") if interpreters else ""
    tag_agents(tree, agent_args)
    for process in processes:
        if process.pid in tree:
            process.name = os.path.basename(tree[process.pid].path)
        else:
            process.name = process.name.strip()
    used_top = bool(processes)
    cpu_processes = processes
    metric = tr("内存占用", "Memory footprint")
    if not used_top and tree:
        usage = footprints(tree)
        cpu_processes = [
            Process(pid, info.cpu, info.rss, os.path.basename(info.path))
            for pid, info in tree.items()
        ]
        if usage:
            metric = tr("物理内存占用（footprint）", "Physical memory footprint")
            processes = [
                Process(p.pid, p.cpu, usage[p.pid], p.name)
                for p in cpu_processes if p.pid in usage
            ]
        else:
            metric = tr("常驻内存 RSS", "Resident memory (RSS)")
            processes = cpu_processes

    pressure = read("/usr/sbin/sysctl", "-n", "kern.memorystatus_vm_pressure_level").strip()
    swap_text = read("/usr/sbin/sysctl", "-n", "vm.swapusage")
    swap = re.search(r"used\s*=\s*([\d.]+\s*[BKMGT])", swap_text)
    ram = size(read("/usr/sbin/sysctl", "-n", "hw.memsize").strip())
    storage = shutil.disk_usage("/System/Volumes/Data" if os.path.isdir("/System/Volumes/Data") else "/")
    rates = {}
    for key in ("Swapins", "Swapouts"):
        if key in before and key in after and after[key] >= before[key]:
            rates[key] = (after[key] - before[key]) / elapsed
    cpu_title = "CPU" if used_top else tr("CPU（ps 近期估计）", "CPU (recent estimate from ps)")
    return Sample(
        idle, processes, cpu_processes, tree, metric, cpu_title, pressure, ram,
        sum(snapshot.get(key, 0) for key in ("Pages free", "Pages inactive", "Pages speculative", "Pages purgeable")),
        after.get("Pages occupied by compressor"), after.get("Pages wired down"),
        after.get("File-backed pages"), size(swap[1]) if swap else None, rates, elapsed, storage.free,
    )


def process_cpu(info):
    times = info["cpu_times"]
    return times.user + times.system if times is not None else None


def sample_portable(seconds):
    windows = sys.platform == "win32"
    owner_field = "username" if windows else "uids"
    start_swap = PSUTIL.swap_memory()
    PSUTIL.cpu_percent(interval=None)
    started = time.monotonic()
    before = {
        proc.pid: (proc.info["create_time"], process_cpu(proc.info))
        for proc in PSUTIL.process_iter(["create_time", "cpu_times"])
    }
    time.sleep(max(0, seconds - (time.monotonic() - started)))
    elapsed = time.monotonic() - started
    idle = 100 - PSUTIL.cpu_percent(interval=None)
    memory = PSUTIL.virtual_memory()
    swap = PSUTIL.swap_memory()
    rates = {} if windows else {
        "Swapins": max(0, swap.sin - start_swap.sin) / elapsed,
        "Swapouts": max(0, swap.sout - start_swap.sout) / elapsed,
    }
    available_ratio = memory.available / memory.total if memory.total else 1
    pressure = "4" if available_ratio < 0.05 else "2" if available_ratio < 0.12 else "1"
    tree, processes, cpu_processes = {}, [], []
    PSUTIL.process_iter.cache_clear()
    attrs = ["name", "exe", "ppid", "create_time", "memory_info", "cpu_times", owner_field]
    for proc in PSUTIL.process_iter(attrs):
        info = proc.info
        pid = proc.pid
        name = info["name"] or f"PID {pid}"
        path = info["exe"] or name
        executable = name.lower().removesuffix(".exe")
        app = PORTABLE_APPS.get(executable, "")
        if executable in {"vmmem", "vmmemwsl"}:
            # Report VM memory without offering to stop the host process.
            name = HELPER_NAMES[executable]
        # Claude Code and Claude Desktop can have similar executable names.
        claude_desktop = executable == "claude" and name in {"Claude", "Claude.exe"} and bool(info["exe"])
        if executable == "claude" and not claude_desktop:
            app = ""
        agent = "" if claude_desktop else identify_agent(path)
        runtime = os.path.basename(path).lower().removesuffix(".exe")
        if runtime in {"node", "nodejs", "bun", "electron"}:
            try:
                argv = proc.cmdline()
                if len(argv) >= 2:
                    entry = argv[2] if argv[1] == "--expose-internals" and len(argv) > 2 else argv[1]
                    agent = identify_agent(path, entry_script=entry)
            except (PSUTIL.NoSuchProcess, PSUTIL.AccessDenied):
                pass
        owner = info[owner_field]
        if not windows and owner is not None:
            owner = owner.real
        creation = info["create_time"]
        previous_creation, previous_cpu = before.get(pid, (None, None))
        current_cpu = process_cpu(info)
        cpu = 0
        if creation == previous_creation and previous_cpu is not None and current_cpu is not None:
            cpu = max(0, current_cpu - previous_cpu) * 100 / elapsed
        rss = info["memory_info"].rss if info["memory_info"] is not None else 0
        tree[pid] = ProcessInfo(info["ppid"], rss, cpu, path, owner, agent, creation, app)
        process = Process(pid, cpu, rss, name)
        if rss:
            processes.append(process)
        if current_cpu is not None:
            cpu_processes.append(process)
    root = os.environ.get("SystemDrive", "C:") + "\\" if windows else "/"
    return Sample(
        idle, processes, cpu_processes, tree, tr("常驻内存 RSS", "Resident memory (RSS)"),
        "CPU", pressure, memory.total, memory.available, None, None, getattr(memory, "cached", None),
        swap.used, rates, elapsed, shutil.disk_usage(root).free,
    )


